{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teacher101",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teacher101",
      "database_id": "6d7fb804-a100-473a-95cc-96dbef71b967",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "APP_TIMEZONE": "Asia/Taipei",
    "MIGRATION_MODE": "0"
  },
  "observability": {
    "enabled": true
  }
}
